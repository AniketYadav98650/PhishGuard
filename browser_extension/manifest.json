
{
  "manifest_version": 3,
  "name": "PhishGuard - Message Protection",
  "version": "1.0.0",
  "description": "Analyze suspicious messages using PhishGuard AI.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard"
  }
}
